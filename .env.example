# vox-streaming -- mẫu cấu hình. Copy thành .env rồi điền.
#
# cmd/server/main.go gọi godotenv.Load() và FATAL nếu thiếu file .env, kể cả khi mọi biến
# đã có sẵn trong môi trường -- nên file này luôn phải tồn tại.
#
# Cổng phải khớp ĐỒNG THỜI ba nơi: khối `ports:` trong docker-compose.yml, EXPOSE trong
# Dockerfile, và cổng vox (Java) gọi tới (spring.grpc.client.channel.vox-streaming.target).
# Hiện tại: 8082 HTTP/WS · 9096 gRPC · 9098 metrics · 50000/udp media.
#
# Chạy bằng docker-compose là chạy trên mạng BRIDGE, nên mọi phụ thuộc nằm trên MÁY (Redis,
# Kafka, agents) phải ghi là host.docker.internal:<cổng> -- "localhost" trong container trỏ
# về chính container. Đừng đổi sang network_mode: host trên Docker Desktop: ở đó "host" là
# máy ảo Linux của Docker chứ không phải máy bạn, và service sẽ chạy mà không ai gọi được.

# ---------------------------------------------------------------------------
# Kafka -- nguồn sự kiện phiên thi
# ---------------------------------------------------------------------------
KAFKA_BROKERS=
KAFKA_CONSUMER_GROUP=
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_TLS_ENABLED=

# ---------------------------------------------------------------------------
# Redis -- state phiên + kho HLS/assembly
# ---------------------------------------------------------------------------
REDIS_ADDR=
REDIS_PASSWORD=

# ---------------------------------------------------------------------------
# Cổng service này tự lắng nghe
# ---------------------------------------------------------------------------
WEBRTC_ADDR=:8082
METRIC_ADDR=:9098
GRPC_ADDR=:9096

# ---------------------------------------------------------------------------
# WebRTC / ICE
# ---------------------------------------------------------------------------
STUN_URLS=
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Dồn TOÀN BỘ media của mọi peer vào MỘT cổng UDP -- bắt buộc khi chạy trong container
# hoặc sau NAT, vì không có nó Pion dùng cổng ephemeral ngẫu nhiên và không thể publish/forward.
WEBRTC_UDP_PORT=50000
# Ghi đè host candidate thành IP mà trình duyệt với tới được. Bỏ trống khi chạy cùng máy/LAN;
# BẮT BUỘC điền khi chạy sau NAT 1:1 hoặc trong Kubernetes, nếu không client không kết nối được.
WEBRTC_NAT_1TO1_IP=
# Chạy bằng docker-compose (bridge): các phụ thuộc dưới đây nằm trên MÁY, không trong
# container -- phải dùng host.docker.internal:<cong>, "localhost" sẽ trỏ về chính container.

# SỐ NHIỀU. main.go đọc ALLOWED_ORIGINS trước, chỉ lùi về ALLOWED_ORIGIN (số ít) nếu trống.
ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Xác thực
# ---------------------------------------------------------------------------
# Phải TRÙNG KHỚP vox/.env JWT_STREAM_SECRET -- token stream do vox ký, service này kiểm.
JWT_STREAM_SECRET=
# Bí mật dùng chung cho gRPC AlertService (agents đẩy cảnh báo gian lận sang).
GRPC_SERVICE_TOKEN=
GRPC_CERT_FILE=
GRPC_KEY_FILE=
GRPC_CA_FILE=

# ---------------------------------------------------------------------------
# gRPC đi RA: vox-streaming -> ExamService của vox
# Bỏ trống thì /readyz báo dependency này là "skipped" thay vì fail.
# ---------------------------------------------------------------------------
EXAM_SERVICE_GRPC_ADDR=
# Đúng tên biến main.go đọc là EXAM_SERVICE_GRPC_CA_FILE (không phải EXAM_GRPC_CA_FILE hay
# EXAM_SERVICE_CA_FILE) -- không có fallback nào, đặt sai tên là CA rỗng và TLS không xác thực.
EXAM_SERVICE_GRPC_CA_FILE=

# ---------------------------------------------------------------------------
# S3 / MinIO -- khung hình + bản ghi
#
# Bucket KHÔNG cần tạo trước: EnsureBuckets tự tạo kèm lifecycle auto-expire nếu chưa có.
# STORAGE_ENDPOINT bỏ trống = dùng endpoint S3 thật của AWS theo STORAGE_REGION.
# ---------------------------------------------------------------------------
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# PHẢI khớp region của bucket thật. Sai region thì AWS SDK ký request cho sai vùng và S3 trả
# PermanentRedirect; tệ hơn, nếu bucket chưa tồn tại thì EnsureBuckets tạo nó ở NHẦM vùng.
# MinIO bỏ qua giá trị này nên lỗi chỉ lộ ra khi chuyển sang S3 thật.
STORAGE_REGION=ap-southeast-1
STORAGE_USE_SSL=
STORAGE_FRAME_BUCKET=
STORAGE_RECORDING_BUCKET=
STORAGE_PRESIGN_MINUTES=

# ---------------------------------------------------------------------------
# Khung hình + ghi hình
# ---------------------------------------------------------------------------
FRAME_INTERVAL_SECS=
FRAME_CONVERT_CONCURRENCY=
# Nơi AssemblerUseCase dựng bản ghi cuối trước khi đẩy lên S3. Trống -> /var/tmp/vox-assembly.
ASSEMBLER_WORK_DIR=
SEGMENT_TEMP_DIR=

# ---------------------------------------------------------------------------
# Cầu ffmpeg-ingest (RTP -> file phân mảnh). TẤT CẢ đều tuỳ chọn -- để trống thì mã dùng
# mặc định hợp lý (dải cổng 40000-41999, mảnh 30s, 10 recorder song song, 3 lần restart,
# dừng sau 5s).
# ---------------------------------------------------------------------------
FFMPEG_INGEST_PORT_RANGE_START=
FFMPEG_INGEST_PORT_RANGE_END=
FFMPEG_INGEST_SEGMENT_SECONDS=
FFMPEG_INGEST_MAX_CONCURRENT=
FFMPEG_INGEST_MAX_RESTART_ATTEMPTS=
FFMPEG_INGEST_STOP_TIMEOUT_SECS=
FFMPEG_INGEST_REORDER_QUEUE_SIZE=
FFMPEG_INGEST_MAX_DELAY_MS=
FFMPEG_INGEST_TEMP_TTL_HOURS=

# ---------------------------------------------------------------------------
# Live-rewind (DVR) HLS cho màn giám sát, chạy song song với bản ghi lưu trữ.
# Tắt trừ khi FFMPEG_INGEST_HLS_ENABLED=true.
# ---------------------------------------------------------------------------
FFMPEG_INGEST_HLS_ENABLED=
FFMPEG_INGEST_HLS_SEGMENT_SECONDS=
FFMPEG_INGEST_HLS_AUDIO_BITRATE_K=
# 0 = phát DVR từ đầu phiên. >0 = cắt playlist còn bấy nhiêu phút cuối. Trống -> 15 phút.
LIVE_REWIND_WINDOW_MINUTES=

# ---------------------------------------------------------------------------
# Lắp ráp bản ghi
# ---------------------------------------------------------------------------
# Thời gian chờ sau stream.ended để client báo hoàn tất, trước khi ráp bằng số mảnh đã có.
# Trống -> 90s.
ASSEMBLY_GRACE_PERIOD_SECS=
ASSEMBLY_WATCHDOG_INTERVAL_SECS=

# ---------------------------------------------------------------------------
# Chuyển tiếp media sang service AI (repo agents). Để tắt trừ khi service đó đang chạy.
# ---------------------------------------------------------------------------
AI_RELAY_ENABLED=false
AI_WEBRTC_URL=
AI_RELAY_QUEUE_SIZE=

SLACK_WEBHOOK_URL=
